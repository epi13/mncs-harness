{
  "name": "mncs-harness-vscode",
  "displayName": "MNCS Harness",
  "description": "Use the existing MNCS Harness from the VS Code Chat window via a trusted Python sidecar.",
  "version": "0.1.0",
  "publisher": "epi13",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["AI", "Other"],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onCommand:mncs-harness.startBackend",
    "onCommand:mncs-harness.stopBackend",
    "onCommand:mncs-harness.restartBackend",
    "onCommand:mncs-harness.runDoctor",
    "onCommand:mncs-harness.previewRoute",
    "onCommand:mncs-harness.showModels",
    "onCommand:mncs-harness.showLanes",
    "onCommand:mncs-harness.showMetrics",
    "onCommand:mncs-harness.openConfig",
    "onCommand:mncs-harness.openSettings",
    "onCommand:mncs-harness.showLogs",
    "onCommand:mncs-harness.selectPythonInterpreter",
    "onCommand:mncs-harness.selectRepository",
    "onLanguageModelChatProvider:mncs"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mncs-harness.startBackend",
        "title": "MNCS Harness: Start Backend"
      },
      {
        "command": "mncs-harness.stopBackend",
        "title": "MNCS Harness: Stop Backend"
      },
      {
        "command": "mncs-harness.restartBackend",
        "title": "MNCS Harness: Restart Backend"
      },
      {
        "command": "mncs-harness.runDoctor",
        "title": "MNCS Harness: Run Doctor"
      },
      {
        "command": "mncs-harness.previewRoute",
        "title": "MNCS Harness: Preview Route"
      },
      {
        "command": "mncs-harness.showModels",
        "title": "MNCS Harness: Show Models"
      },
      {
        "command": "mncs-harness.showLanes",
        "title": "MNCS Harness: Show Lanes"
      },
      {
        "command": "mncs-harness.showMetrics",
        "title": "MNCS Harness: Show Metrics"
      },
      {
        "command": "mncs-harness.openConfig",
        "title": "MNCS Harness: Open Harness Configuration"
      },
      {
        "command": "mncs-harness.openSettings",
        "title": "MNCS Harness: Open Extension Settings"
      },
      {
        "command": "mncs-harness.showLogs",
        "title": "MNCS Harness: Show Logs"
      },
      {
        "command": "mncs-harness.selectPythonInterpreter",
        "title": "MNCS Harness: Select Python Interpreter"
      },
      {
        "command": "mncs-harness.selectRepository",
        "title": "MNCS Harness: Select Repository"
      }
    ],
    "chatParticipants": [
      {
        "id": "mncs.harness",
        "name": "mncs",
        "fullName": "MNCS Harness",
        "isDefault": false,
        "commands": [
          { "name": "route" },
          { "name": "doctor" },
          { "name": "models" },
          { "name": "lanes" },
          { "name": "metrics" },
          { "name": "chat" },
          { "name": "ocr" },
          { "name": "coding" },
          { "name": "review" }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "mncs",
        "id": "mncs",
        "name": "MNCS Harness"
      }
    ],
    "configuration": {
      "title": "MNCS Harness",
      "properties": {
        "mncsHarness.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Absolute Python interpreter path for the trusted backend sidecar."
        },
        "mncsHarness.repositoryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the local harness repository root."
        },
        "mncsHarness.configPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the harness configuration file."
        },
        "mncsHarness.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the Python sidecar when the extension activates."
        },
        "mncsHarness.showRouting": {
          "type": "boolean",
          "default": true,
          "description": "Show route preview and routing status in chat responses."
        },
        "mncsHarness.logLevel": {
          "type": "string",
          "default": "info",
          "enum": ["debug", "info", "warning", "error"],
          "description": "Log verbosity for the VS Code extension output channel."
        },
        "mncsHarness.requestTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Timeout for backend requests before returning a response error."
        },
        "mncsHarness.maxImageBytes": {
          "type": "number",
          "default": 4194304,
          "description": "Maximum size for an attached image payload to be sent to the backend."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -p ./tsconfig.json --watch",
    "lint": "tsc -p ./tsconfig.json --noEmit",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && node --test ./dist/test/**/*.test.js",
    "test:integration": "node -e \"console.log('Integration tests are opt-in and require ELH_RUN_VSCODE_INTEGRATION=1 or ELH_RUN_OLLAMA_INTEGRATION=1.')\"",
    "package": "npx @vscode/vsce package --out ./mncs-harness-vscode-0.1.0.vsix",
    "install-local": "code --install-extension ./mncs-harness-vscode-0.1.0.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  }
}
